# DeepVision 后端环境变量示例
# 复制为 .env 后按需修改

APP_NAME=DeepVision API
DEBUG=false

# 必须修改：生产环境使用强随机值，例如 python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# SQLite（开发）：sqlite:///./deepvision.db
# PostgreSQL（生产）：postgresql+psycopg://user:pass@localhost:5432/deepvision
DATABASE_URL=sqlite:///./deepvision.db

# CORS 白名单，JSON 数组
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---------------------------------------------------------------------------
# AI 助教（不配置时自动降级为内置知识库，功能完整可用）
# ---------------------------------------------------------------------------
# none | openai（openai 表示任何兼容 OpenAI /chat/completions 协议的服务）
LLM_PROVIDER=none
# 密钥；留空等同未配置
LLM_API_KEY=
# 服务地址，注意要包含版本路径（下面的代码会拼 /chat/completions）
LLM_BASE_URL=https://api.openai.com/v1
# 模型名
LLM_MODEL=gpt-4o-mini
# 单次请求超时（秒）
LLM_TIMEOUT_SECONDS=30
# 每用户每分钟问答次数上限
AI_RATE_LIMIT_PER_MINUTE=20

# 常见服务示例（取消注释并替换 KEY 即可）：
#
# 智谱 GLM
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
#
# DeepSeek
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
#
# 阿里通义（OpenAI 兼容模式）
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
#
# 本地 Ollama（Key 随便填一个非空值即可）
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama
